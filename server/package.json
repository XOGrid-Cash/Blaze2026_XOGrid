{
  "name": "xogrid-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest --run",
    "test:postgres": "vitest --run --no-file-parallelism",
    "cli": "tsx src/cli.ts",
    "cli:prod": "node dist/cli.js"
  },
  "devDependencies": {
    "@types/better-sqlite3": "9.6.0",
    "@types/node": "26.6.6",
    "@types/pg": "8.23.1",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "8.3.7",
    "vitest": "5.1.0"
  },
  "dependencies": {
    "@bitauth/libauth": "3.1.0-next.8",
    "@fastify/rate-limit": "11.2.2",
    "@fastify/static": "8.0.4",
    "@xo-cash/crypto": "0.0.5",
    "@xo-cash/engine": "0.1.1-next.18029697917",
    "@xo-cash/state": "0.0.5",
    "@xo-cash/templates": "0.0.12",
    "@xo-cash/utils": "0.0.11",
    "better-sqlite3": "13.2.0",
    "fastify": "5.12.8",
    "kysely": "0.29.8",
    "pg": "8.23.1"
  },
  "overrides": {
    "canvas": "npm:empty-npm-package@1.0.0"
  },
  "resolutions": {
    "canvas": "npm:empty-npm-package@1.0.0"
  },
  "allowScripts": {
    "sqlite3@5.1.7": true,
    "better-sqlite3@12.11.1": true,
    "esbuild@0.28.2": true
  }
}
