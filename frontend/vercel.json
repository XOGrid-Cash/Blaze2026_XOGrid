{
  "installCommand": "npm install --ignore-scripts --legacy-peer-deps --no-audit --no-fund",
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "https://blaze2026-xogrid.onrender.com/api/$1"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ]
}
